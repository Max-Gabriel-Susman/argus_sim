# Doxyfile -- documentation for argus_sim's Python tools
#
#   doxygen                                   build (run from the package root)
#   xdg-open build/html/index.html            view
#
# Only the settings that differ from Doxygen's defaults are listed; every
# tag not named here keeps its default. `doxygen -g reference.cfg` writes
# the full list with every tag explained, if you need to look one up.
#
# The Rust code (the relay, the node, the bindings) is documented by
# rustdoc instead: `cargo doc --workspace --no-deps --open`.
#
# Written for Doxygen 1.9.1, Ubuntu 22.04's package, which the CI job
# installs too.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------

PROJECT_NAME           = "Argus Sim"
PROJECT_BRIEF          = "The host end of the replay protocol, and the feature toolchain: model, data, validation"

# build/ is already in .gitignore. colcon builds this package under the
# workspace's own build/, not here, so the two never meet.
OUTPUT_DIRECTORY       = build

#---------------------------------------------------------------------------
# What to read
#---------------------------------------------------------------------------

# The Python tools, with README.md as the front page.
INPUT                  = README.md \
                         tools
FILE_PATTERNS          = *.py
RECURSIVE              = YES

USE_MDFILE_AS_MAINPAGE = README.md

#---------------------------------------------------------------------------
# How to read it
#---------------------------------------------------------------------------

# Python docstrings are shown as written (PYTHON_DOCSTRING, on by default):
# the tools' docstrings are their --help text, and they read best verbatim.

# Show every file, function and variable, documented or not, so the site
# is complete from the first run.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES

# Names with a leading underscore are shown too, should a tool grow
# private helpers.
EXTRACT_PRIVATE        = YES

#---------------------------------------------------------------------------
# What to write
#---------------------------------------------------------------------------

GENERATE_LATEX         = NO

# A navigation tree on the left and browsable, cross-referenced source.
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# Graphs need Graphviz (the dot program): which helper calls which, in
# each tool.
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------

# Print nothing on a clean run, so anything printed is worth reading.
QUIET                  = YES

# A documented function must document every parameter.
WARN_NO_PARAMDOC       = YES
